{
  "$schema": "https://raw.githubusercontent.com/railwayapp/cli/main/assets/config.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": "."
  },
  "deploy": {
    "startCommand": "npm start -- -H 0.0.0.0 -p ${PORT:-3000}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowSeconds": 60
  }
}
