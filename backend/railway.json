{
  "$schema": "https://raw.githubusercontent.com/railwayapp/cli/main/assets/config.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": "."
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"gunicorn config.wsgi:application --bind 0.0.0.0:$PORT\"",
    "healthcheckPath": "/api/v1/",
    "healthcheckTimeout": 30,
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowSeconds": 60
  }
}
