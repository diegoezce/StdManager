# Django Settings (set in Railway Backend Service)
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database - Railway AUTOMATICALLY PROVIDES this via PostgreSQL plugin
# DO NOT SET MANUALLY - Railway provides it automatically
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Redis - Railway AUTOMATICALLY PROVIDES this via Redis plugin
# DO NOT SET MANUALLY - Railway provides it automatically
# REDIS_URL=redis://host:port/0

# CORS - Backend needs to know frontend URL
CORS_ALLOWED_ORIGINS=https://yourdomain-frontend.railway.app

# Frontend (set in Railway Frontend Service)
NEXT_PUBLIC_API_URL=https://yourdomain-backend.railway.app/api/v1

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Time Zone
TIME_ZONE=UTC

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
